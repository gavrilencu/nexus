<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy Auto Backup rules (API < 31). allowBackup is false, so this is
   defense-in-depth: even if backup were enabled, never let the MITM CA key
   material or saved API keys leave the device.
-->
<full-backup-content>
    <exclude domain="file" path="mitm_ca/" />
    <exclude domain="sharedpref" path="nexus_hibp.xml" />
</full-backup-content>
