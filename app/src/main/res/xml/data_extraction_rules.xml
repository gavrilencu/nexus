<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup / device-transfer rules. allowBackup is false, but
   device-to-device transfer is governed here, so explicitly exclude the MITM
   CA key material and saved API keys from both channels.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="mitm_ca/" />
        <exclude domain="sharedpref" path="nexus_hibp.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="mitm_ca/" />
        <exclude domain="sharedpref" path="nexus_hibp.xml" />
    </device-transfer>
</data-extraction-rules>
